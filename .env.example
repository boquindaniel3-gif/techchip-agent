# API (Docker / Railway)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo proyectos legacy HS256. Si usas JWKS (ES256), déjalo vacío.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,https://tu-app.vercel.app
# true = sin JWT (solo desarrollo local)
AUTH_DISABLED=true

# Web (Next.js / Vercel) — copiar también a web/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
